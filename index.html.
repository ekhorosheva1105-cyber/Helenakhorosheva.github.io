<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Елена Хорошева — бренд- и продакт-менеджер</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#EFEDE6;
    --paper-alt:#E4E0D2;
    --ink:#17211E;
    --ink-soft:#4B554F;
    --teal:#1F5C54;
    --teal-dark:#123430;
    --amber:#E8A33D;
    --brick:#B8472A;
    --line:#D2CCB9;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Manrope',sans-serif;
    font-size:16px;
    line-height:1.55;
  }
  h1,h2,h3{font-family:'Unbounded',sans-serif;margin:0;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 28px;}

  /* ---------- NAV ---------- */
  nav{
    position:sticky;top:0;z-index:50;
    background:rgba(239,237,230,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;}
  .nav-name{font-family:'Unbounded';font-weight:700;font-size:15px;letter-spacing:.02em;}
  .nav-links{display:flex;gap:28px;list-style:none;margin:0;padding:0;}
  .nav-links a{color:var(--ink);text-decoration:none;font-size:14px;font-weight:600;padding-bottom:4px;border-bottom:2px solid transparent;transition:border-color .15s ease;}
  .nav-links a:hover{border-color:var(--amber);}

  /* ---------- HERO ---------- */
  .hero{padding:88px 0 64px;position:relative;overflow:hidden;}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center;}
  .eyebrow{
    font-family:'JetBrains Mono';font-size:13px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--teal);font-weight:600;margin-bottom:18px;display:flex;align-items:center;gap:10px;
  }
  .eyebrow::before{content:"";width:22px;height:2px;background:var(--brick);display:inline-block;}
  .hero h1{font-size:clamp(36px,5vw,54px);font-weight:900;line-height:1.05;letter-spacing:-.01em;}
  .hero h1 span{color:var(--teal);}
  .hero p.lead{font-size:18px;color:var(--ink-soft);max-width:520px;margin:22px 0 32px;}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:14px 24px;border-radius:100px;font-weight:700;font-size:15px;
    text-decoration:none;transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn-primary{background:var(--teal);color:#fff;}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(31,92,84,.28);}
  .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink);}
  .btn-ghost:hover{border-color:var(--amber);color:var(--brick);}

  /* price-tag signature element */
  .tag{
    position:relative;
    background:var(--amber);
    color:var(--teal-dark);
    padding:22px 26px 22px 38px;
    clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%);
    display:inline-block;
    box-shadow:0 14px 26px rgba(184,71,42,.18);
  }
  .tag::after{
    content:"";position:absolute;left:13px;top:50%;transform:translateY(-50%);
    width:9px;height:9px;border-radius:50%;background:var(--paper);
  }
  .tag .num{font-family:'Unbounded';font-weight:900;font-size:34px;line-height:1;display:block;}
  .tag .label{font-family:'JetBrains Mono';font-size:12px;letter-spacing:.05em;text-transform:uppercase;margin-top:6px;display:block;}
  .hero-card{
    background:var(--teal-dark);
    border-radius:20px;
    padding:36px 32px;
    color:#F3F1E8;
    position:relative;
  }
  .hero-card .tag{margin-bottom:22px;}
  .hero-card ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px;}
  .hero-card li{display:flex;gap:12px;font-size:14.5px;color:#DCE3DF;}
  .hero-card li b{color:#fff;}
  .hero-card li::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--amber);margin-top:7px;flex:none;}

  /* ---------- SECTION HEADERS ---------- */
  section{padding:64px 0;}
  .sec-head{display:flex;align-items:baseline;gap:14px;margin-bottom:36px;}
  .sec-head .idx{font-family:'JetBrains Mono';color:var(--brick);font-weight:600;font-size:14px;}
  .sec-head h2{font-size:28px;font-weight:800;}
  .sec-sub{color:var(--ink-soft);max-width:560px;margin:-24px 0 36px;font-size:15px;}

  /* ---------- SPEC TABLE (characteristics -> benefits) ---------- */
  .specs{border-top:1px solid var(--line);}
  .spec-row{
    display:grid;grid-template-columns:1fr 40px 1fr;gap:20px;align-items:center;
    padding:22px 0;border-bottom:1px solid var(--line);
  }
  .spec-row .fact{font-family:'JetBrains Mono';font-size:14px;color:var(--ink-soft);}
  .spec-row .fact b{color:var(--ink);font-weight:600;}
  .arrow{color:var(--amber);font-size:20px;text-align:center;}
  .spec-row .benefit{font-size:15.5px;font-weight:600;}

  /* ---------- CASE CARDS ---------- */
  .cases-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;}
  .case-card{
    background:#fff;border:1px solid var(--line);border-radius:var(--radius);
    padding:26px 26px 24px;position:relative;overflow:hidden;
    transition:box-shadow .18s ease, transform .18s ease;
  }
  .case-card:hover{box-shadow:0 16px 34px rgba(23,33,30,.10);transform:translateY(-3px);}
  .case-card .co{
    font-family:'JetBrains Mono';font-size:12.5px;color:var(--teal);font-weight:600;
    text-transform:uppercase;letter-spacing:.04em;margin-bottom:10px;
  }
  .case-card h3{font-size:19px;font-weight:700;line-height:1.3;margin-bottom:12px;padding-right:86px;}
  .case-card p{font-size:14.5px;color:var(--ink-soft);margin:0 0 16px;}
  .case-card .metric{
    position:absolute;top:22px;right:-6px;
    background:var(--amber);color:var(--teal-dark);
    font-family:'Unbounded';font-weight:700;font-size:13px;
    padding:8px 16px 8px 14px;
    clip-path:polygon(12px 0,100% 0,100% 100%,12px 100%,0 50%);
  }
  .case-card .results{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;}
  .case-card .results li{font-size:13.5px;display:flex;gap:8px;}
  .case-card .results li::before{content:"—";color:var(--brick);flex:none;}

  /* ---------- SKILLS ---------- */
  .chips{display:flex;flex-wrap:wrap;gap:10px;}
  .chip{
    background:var(--paper-alt);border:1px solid var(--line);
    padding:9px 16px;border-radius:100px;font-size:13.5px;font-weight:600;
    color:var(--teal-dark);
  }

  /* ---------- PORTFOLIO LINK CARDS ---------- */
  .link-card{
    display:flex;flex-direction:column;justify-content:space-between;gap:14px;
    background:#fff;border:1px solid var(--line);border-radius:var(--radius);
    padding:22px 24px;text-decoration:none;color:var(--ink);
    transition:box-shadow .18s ease, transform .18s ease, border-color .18s ease;
  }
  .link-card:hover{box-shadow:0 16px 34px rgba(23,33,30,.10);transform:translateY(-3px);border-color:var(--teal);}
  .link-card .lc-title{font-size:16.5px;font-weight:700;line-height:1.3;}
  .link-card .lc-desc{font-size:14px;color:var(--ink-soft);}
  .link-card .lc-go{font-family:'JetBrains Mono';font-size:13px;font-weight:600;color:var(--teal);}
  .featured-card{
    display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;
    background:var(--teal-dark);color:#F3F1E8;border-radius:var(--radius);
    padding:26px 28px;text-decoration:none;margin-bottom:20px;
    transition:transform .18s ease;
  }
  .featured-card:hover{transform:translateY(-3px);}
  .featured-card .fc-eyebrow{font-family:'JetBrains Mono';font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--amber);margin-bottom:6px;}
  .featured-card .fc-title{font-size:19px;font-weight:700;color:#fff;}
  .featured-card .fc-desc{font-size:14px;color:#DCE3DF;margin-top:4px;}
  .featured-card .fc-go{flex:none;font-family:'JetBrains Mono';font-size:13px;font-weight:700;color:var(--amber);white-space:nowrap;}
  .links-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  .more-portfolio{display:block;text-align:center;margin-top:24px;color:var(--teal);font-weight:700;text-decoration:none;font-size:14.5px;}
  .more-portfolio:hover{color:var(--brick);}
  @media (max-width:860px){.links-grid{grid-template-columns:1fr;}}

  /* ---------- CONTACT / FOOTER ---------- */
  footer{
    background:var(--teal-dark);color:#F3F1E8;padding:70px 0 40px;margin-top:40px;
  }
  footer .eyebrow{color:var(--amber);}
  footer .eyebrow::before{background:var(--amber);}
  footer h2{color:#fff;font-size:30px;font-weight:800;max-width:520px;}
  .contact-grid{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:28px;margin-top:32px;}
  .contact-links{display:flex;flex-direction:column;gap:10px;font-size:15px;}
  .contact-links a{color:#F3F1E8;text-decoration:none;border-bottom:1px solid rgba(243,241,232,.35);}
  .contact-links a:hover{border-color:var(--amber);color:var(--amber);}
  .contact-buttons{display:flex;gap:12px;flex-wrap:wrap;align-items:center;}
  .btn-sm{padding:10px 18px;font-size:13.5px;}
  .btn-outline-light{background:transparent;color:#F3F1E8;border:1.5px solid rgba(243,241,232,.5);}
  .btn-outline-light:hover{border-color:var(--amber);color:var(--amber);}
  .foot-note{margin-top:56px;padding-top:20px;border-top:1px solid rgba(243,241,232,.15);font-size:12.5px;color:#9EAEA7;font-family:'JetBrains Mono';}

  .reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease, transform .5s ease;}
  .reveal.in{opacity:1;transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){.reveal{opacity:1;transform:none;transition:none;}}

  @media (max-width:860px){
    .hero-grid{grid-template-columns:1fr;}
    .cases-grid{grid-template-columns:1fr;}
    .spec-row{grid-template-columns:1fr;text-align:left;}
    .arrow{transform:rotate(90deg);text-align:left;}
    .nav-links{display:none;}
  }
</style>
</head>
